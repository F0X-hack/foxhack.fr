{
  "name": "foxhack-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FoXhack — Offensive Security Researcher portfolio / personal security lab.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
