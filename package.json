{
  "name": "foxhack-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FoXhack — Offensive Security Researcher portfolio / personal security lab.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "dev:clean": "rm -rf node_modules/.vite && vite --host 0.0.0.0 --port 5173",
    "clean": "rm -rf dist dist-ssr node_modules/.vite",
    "check:scrollspy": "node scripts/check-scrollspy.mjs",
    "check:url": "node scripts/check-section-url.mjs",
    "doctor": "sh scripts/doctor.sh dist https://foxhack.fr",
    "vault:index": "node scripts/build-offsidian.mjs",
    "check:emoji": "node scripts/strip-emoji.mjs --check",
    "check:offsidian": "tsx scripts/smoke-offsidian.tsx && tsx scripts/smoke-offsidian-dom.tsx",
    "bench:offsidian": "tsx scripts/bench-offsidian.tsx"
  },
  "dependencies": {
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "mermaid": "^12.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^13.21.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
